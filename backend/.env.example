# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# PostgreSQL (matches docker-compose.yml at the repo root)
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@127.0.0.1:5433/jarvis

# Optional overrides (defaults shown)
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=medium              # low | medium | high | xhigh | max
# JARVIS_MAX_TOKENS=16000
# JARVIS_MAX_AGENT_STEPS=15

# Folders the file tools may touch, separated by ';' on Windows (':' elsewhere). Default: your home folder.
# JARVIS_ALLOWED_ROOTS=C:\Users\you\Documents;C:\Users\you\Downloads

# Highest permission level that runs without asking (0-3). Default 1 = reading is automatic, writing asks.
# JARVIS_AUTO_APPROVE_LEVEL=1
