# Copy to .env and adjust. Never commit .env.

# Which model runs JARVIS:
#   ollama    - free local model (default). Needs Ollama running; see README.
#   anthropic - Claude API. Needs ANTHROPIC_API_KEY and paid credits.
# JARVIS_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=

# PostgreSQL (matches docker-compose.yml at the repo root)
# DATABASE_URL=postgresql+psycopg://jarvis:jarvis@127.0.0.1:5433/jarvis

# Optional overrides (defaults shown)
# JARVIS_MODEL=jarvis-qwen3            # default per provider: jarvis-qwen3 / claude-opus-5-5
# JARVIS_EFFORT=medium              # Claude only: low | medium | high | xhigh | max
# JARVIS_MAX_TOKENS=4096             # default 4096 (ollama) / 16000 (anthropic)
# JARVIS_MAX_AGENT_STEPS=15

# Folders the file tools may touch, separated by ';' on Windows (':' elsewhere). Default: your home folder.
# JARVIS_ALLOWED_ROOTS=C:\Users\you\Documents;C:\Users\you\Downloads

# Highest permission level that runs without asking (0-3). Default 1 = reading is automatic, writing asks.
# JARVIS_AUTO_APPROVE_LEVEL=1

# Memory: local Ollama embedding model (must produce 768-dim vectors) and how related a memory must be
# (cosine similarity, 0-1) to be attached to a message automatically.
# JARVIS_EMBEDDING_MODEL=nomic-embed-text
# JARVIS_MEMORY_MIN_SIMILARITY=0.55
